#!/usr/bin/env sh
set -e

CHANGED_FILES="$(git diff --cached --name-only --diff-filter=ACMRTUXB)"

if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

RELEVANT_FILES="$(printf '%s\n' "$CHANGED_FILES" | grep -E '^(app/|build\.gradle\.kts$|settings\.gradle\.kts$|gradle\.properties$|scripts/|\.github/workflows/)' | grep -Ev '^(distribution-site/|version\.properties$|docs/|README\.md$|\.githooks/)' || true)"

if [ -z "$RELEVANT_FILES" ]; then
  exit 0
fi

echo "Detected app code changes. Bumping version and syncing distribution-site..."

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./scripts/bump-version.ps1"
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "./scripts/bump-version.ps1"
else
  echo "PowerShell is required to auto-bump the app version." >&2
  exit 1
fi

git add version.properties distribution-site/index.html distribution-site/latest.json
